# ====== WAJIB ======
# API key Gemini (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# API key Pixabay (gratis & instan tanpa review): https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key

# ====== OPSIONAL ======
# (Opsional jika punya akun Pexels):
PEXELS_API_KEY=

# Model via CrewAI
GEMINI_MODEL=gemini/gemini-2.5-flash
LLM_TEMPERATURE=0.7
AGENT_MAX_ITER=2
CREW_MAX_RPM=10

# Suara narator Edge-TTS & kecepatan dasar (persen)
TTS_VOICE=id-ID-ArdiNeural
TTS_BASE_RATE=8

# Target durasi video (detik)
TARGET_MIN_SECONDS=50
TARGET_MAX_SECONDS=59

# Model faster-whisper: tiny | base | small
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Musik latar (dB relatif) & subtitle
MUSIC_VOLUME_DB=-18
SUBTITLE_FONT=Arial Black
SUBTITLE_FONT_SIZE=88

# Jeda antar video (detik) untuk menjaga rate limit Gemini Free Tier
DELAY_BETWEEN_RUNS=5

# ====== YOUTUBE UPLOAD (OPSIONAL) ======
# OAuth credentials disimpan di config/client_secret.json
# Setup: python scripts/setup_youtube_manual.py

# Upload defaults
YOUTUBE_DEFAULT_PRIVACY=public
YOUTUBE_CATEGORY=27
